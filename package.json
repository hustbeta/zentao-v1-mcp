{
  "name": "zentao-v1-mcp",
  "version": "0.1.1",
  "description": "MCP server for ZenTao RESTful API v1",
  "repository": {
    "type": "git",
    "url": "https://github.com/hustbeta/zentao-v1-mcp"
  },
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "zentao-v1-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "doc",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "vitest run tests/smoke/stdio-smoke.test.ts",
    "verify": "npm run build && npm test && npm run smoke && npm audit --audit-level=moderate && npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test && npm run smoke && npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
